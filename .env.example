# Placeholders for every environment variable docker-compose.yml references
# for the backend/reverb services, plus the shared infra services they depend
# on (Postgres, MinIO, Mailhog, pgAdmin). No real secrets - copy to .env and
# fill in real local values.

# App (standard Laravel bootstrap keys - `php artisan key:generate` only
# rewrites an existing APP_KEY= line, so it must be present even empty)
APP_NAME=QualORock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost
QUEUE_CONNECTION=database
MAIL_MAILER=log
BACKEND_PORT=8000

# Admin-panel SPA session cookie (AD-008 - HttpOnly/Secure/SameSite, no token in localStorage)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Database (AD-004 - Postgres only, no SQLite/MySQL fallback)
DB_CONNECTION=pgsql

# Postgres (least-privilege app user, per AD-008 - never the superuser)
POSTGRES_DB=qualorock
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Reverb (websocket)
REVERB_APP_ID=change_me
REVERB_APP_KEY=change_me
REVERB_APP_SECRET=change_me
REVERB_PORT=8080

# MinIO (S3-compatible storage, AD-009)
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=qualorock
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailhog (local SMTP catcher)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# pgAdmin (local Postgres admin UI)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050
